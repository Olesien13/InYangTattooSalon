<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.EmployeesController">
    <children>
        <TableView fx:id="employeesTable" layoutX="30.0" layoutY="67.0" prefHeight="292.0" prefWidth="530.0" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #333;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="26.0" style="-fx-background-radius: 15; -fx-border-radius: 15;" text="ID" />
                <TableColumn fx:id="colName" prefWidth="124.0" style="-fx-background-radius: 15; -fx-border-radius: 15;" text="ФИО" />
                <TableColumn fx:id="colPhone" prefWidth="83.0" style="-fx-background-radius: 15; -fx-border-radius: 15;" text="Телефон" />
                <TableColumn fx:id="colPosition" prefWidth="110.0" style="-fx-background-radius: 15; -fx-border-radius: 15;" text="Должность" />
                <TableColumn fx:id="colHireDate" prefWidth="102.0" style="-fx-background-radius: 15; -fx-border-radius: 15;" text="Дата (трудоустройства)" />
                <TableColumn fx:id="colSalary" prefWidth="81.0" style="-fx-background-radius: 15; -fx-border-radius: 15;" text="Зарплата" />
            </columns>
        </TableView>

        <ButtonBar buttonMinWidth="0.0" layoutX="95.0" layoutY="20.0" prefHeight="31.0" prefWidth="411.0" style="-fx-background-radius: 20; -fx-border-color: #771011; -fx-border-radius: 20;">
            <buttons>
                <Button fx:id="employeesMenuBtn" alignment="CENTER" mnemonicParsing="false" onAction="#goToEmployees" prefHeight="31.0" prefWidth="119.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Сотрудники" textAlignment="CENTER" textFill="WHITE">
                    <font>
                        <Font name="Open Sans Regular" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="consumablesMenuBtn" mnemonicParsing="false" onAction="#goToConsumables" prefHeight="29.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" text="Расходники" textFill="#771011">
                    <font>
                        <Font name="Open Sans Regular" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="servicesMenuBtn" mnemonicParsing="false" onAction="#goToServices" prefHeight="29.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" text="Услуги" textFill="#771011">
                    <font>
                        <Font name="Open Sans Regular" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="clientsMenuBtn" mnemonicParsing="false" onAction="#goToClients" prefHeight="31.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" text="Клиенты" textFill="#771011">
                    <font>
                        <Font name="Open Sans Regular" size="13.0" />
                    </font>
                </Button>
            </buttons>
            <padding>
                <Insets left="-20.0" />
            </padding>
        </ButtonBar>

        <Button fx:id="backButton" alignment="CENTER" layoutX="19.0" layoutY="376.0" mnemonicParsing="false" onAction="#goBack" prefHeight="29.0" prefWidth="76.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Назад" textAlignment="CENTER" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <Button fx:id="editButton" alignment="CENTER" layoutX="489.0" layoutY="376.0" mnemonicParsing="false" onAction="#editEmployee" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Изменить" textAlignment="CENTER" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <Button fx:id="addButton" alignment="CENTER" layoutX="392.0" layoutY="376.0" mnemonicParsing="false" onAction="#addEmployee" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Добавить" textAlignment="CENTER" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <Button fx:id="deleteButton" alignment="CENTER" layoutX="295.0" layoutY="376.0" mnemonicParsing="false" onAction="#deleteEmployee" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Удалить" textAlignment="CENTER" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" />
        <Button fx:id="scheduleButton" alignment="CENTER" layoutX="134.0" layoutY="376.0" mnemonicParsing="false" onAction="#showSchedule" prefHeight="29.0" prefWidth="129.0" style="-fx-background-radius: 20; -fx-background-color: #F9F6F0; -fx-border-color: #771011; -fx-border-radius: 20;" text="Расписание" textAlignment="CENTER" textFill="#771011">
         <font>
            <Font name="Open Sans Regular" size="13.0" />
         </font>
      </Button>
    </children>
</AnchorPane>
