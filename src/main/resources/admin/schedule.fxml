<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.ScheduleController">
    <children>
        <!-- Таблица расписания -->
        <TableView fx:id="scheduleTable" layoutX="15.0" layoutY="75.0" prefHeight="281.0" prefWidth="571.0" style="-fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #333;">
            <columns>
                <TableColumn fx:id="colMaster" prefWidth="77.0" text="Мастер" />
                <TableColumn fx:id="colMon" prefWidth="70.0" text="Пн" />
                <TableColumn fx:id="colTue" prefWidth="70.0" text="Вт" />
                <TableColumn fx:id="colWed" prefWidth="70.0" text="Ср" />
                <TableColumn fx:id="colThu" prefWidth="70.0" text="Чт" />
                <TableColumn fx:id="colFri" prefWidth="70.0" text="Пт" />
                <TableColumn fx:id="colSat" prefWidth="70.0" text="Сб" />
                <TableColumn fx:id="colSun" prefWidth="70.0" text="Вс" />
            </columns>
        </TableView>

        <!-- Заголовок с кнопкой меню -->
        <ButtonBar buttonMinWidth="0.0" layoutX="95.0" layoutY="20.0" prefHeight="31.0" prefWidth="411.0" style="-fx-background-radius: 20; -fx-border-color: #771011; -fx-border-radius: 20;">
            <buttons>
                <Button fx:id="employeesMenuBtn" alignment="CENTER" mnemonicParsing="false" onAction="#goToEmployees" prefHeight="26.0" prefWidth="408.0" style="-fx-background-radius: 20; -fx-background-color: #F9F6F0;" text="Расписание мастеров" textFill="#771011">
                    <font>
                        <Font name="Open Sans Regular" size="13.0" />
                    </font>
                </Button>
            </buttons>
            <padding>
                <Insets left="-20.0" />
            </padding>
        </ButtonBar>

        <!-- Кнопка Назад -->
        <Button fx:id="backButton" alignment="CENTER" layoutX="19.0" layoutY="376.0" mnemonicParsing="false" onAction="#goBack" prefHeight="29.0" prefWidth="76.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Назад" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- Кнопка Добавить -->
        <Button fx:id="addButton" alignment="CENTER" layoutX="481.0" layoutY="376.0" mnemonicParsing="false" onAction="#addSchedule" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Добавить" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- Кнопка Изменить -->
        <Button fx:id="editButton" alignment="CENTER" layoutX="384.0" layoutY="376.0" mnemonicParsing="false" onAction="#editSchedule" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Изменить" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- Кнопка Удалить -->
        <Button fx:id="deleteButton" alignment="CENTER" layoutX="287.0" layoutY="376.0" mnemonicParsing="false" onAction="#deleteSchedule" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Удалить" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- Нижняя полоска -->
        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" />
    </children>
</AnchorPane>
