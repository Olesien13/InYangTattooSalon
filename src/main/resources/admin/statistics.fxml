<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.StatisticsController">
    <stylesheets>
        <URL value="@chart-colors.css" />
    </stylesheets>
    <children>

        <ButtonBar buttonMinWidth="0.0" layoutX="95.0" layoutY="20.0" prefHeight="31.0" prefWidth="411.0" style="-fx-background-radius: 20; -fx-border-color: #771011; -fx-border-radius: 20;">
            <buttons>
                <Button alignment="CENTER" mnemonicParsing="false" prefHeight="26.0" prefWidth="406.0" style="-fx-background-radius: 20; -fx-background-color: #F9F6F0;" text="Статистика" textFill="#771011">
                    <font>
                        <Font name="Open Sans Regular" size="13.0" />
                    </font>
                </Button>
            </buttons>
            <padding>
                <Insets left="-20.0" />
            </padding>
        </ButtonBar>

        <!-- Вкладки -->
        <TabPane layoutX="20.0" layoutY="70.0" prefHeight="310.0" prefWidth="560.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Доход компании">
                    <content>
                        <AnchorPane prefHeight="280.0" prefWidth="560.0">
                            <PieChart fx:id="revenueChart" layoutX="140.0" prefHeight="250.0" prefWidth="275.0" title="Общий доход компании" />
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab text="Заработок мастеров">
                    <content>
                        <AnchorPane prefHeight="280.0" prefWidth="560.0">
                            <BarChart fx:id="masterRevenueBarChart" layoutX="-4.0" layoutY="-4.0" prefHeight="258.0" prefWidth="543.0" title="Заработок мастеров с клиентов">
                                <xAxis>
                                    <CategoryAxis label="Мастер" side="BOTTOM" fx:id="xAxis" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="yAxis" label="Заработок (руб)" side="LEFT" />
                                </yAxis>
                            </BarChart>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
         <padding>
            <Insets right="5.0" />
         </padding>
        </TabPane>

        <Button fx:id="backButton" alignment="CENTER" layoutX="19.0" layoutY="386.0" mnemonicParsing="false" onAction="#goBack" prefHeight="29.0" prefWidth="76.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Назад" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" />
    </children>
</AnchorPane>
