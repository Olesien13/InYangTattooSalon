<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.ConsumablesController">
    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>
    <children>
        <TableView fx:id="consumablesTable" layoutX="57.0" layoutY="83.0" prefHeight="258.0" prefWidth="472.0" styleClass="table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="40.0" text="Id">
               <styleClass>
                  <String fx:value="table-header" />
                  <String fx:value="table-header-bok-right" />
               </styleClass></TableColumn>
                <TableColumn fx:id="colName" prefWidth="146.0" styleClass="table-header" text="Название" />
                <TableColumn fx:id="colQuantity" prefWidth="141.0" styleClass="table-header" text="Количество" />
                <TableColumn fx:id="colPrice" prefWidth="63.0" styleClass="table-header" text="Цена" />
                <TableColumn fx:id="colUnit" prefWidth="79.0" text="Ед.изм">
               <styleClass>
                  <String fx:value="table-header" />
                  <String fx:value="table-header-bok-left" />
               </styleClass></TableColumn>
            </columns>
        </TableView>

        <ButtonBar buttonMinWidth="0.0" layoutX="95.0" layoutY="20.0" prefHeight="31.0" prefWidth="411.0" style="-fx-background-radius: 20; -fx-border-color: #771011; -fx-border-radius: 20;">
            <buttons>
                <Button fx:id="employeesMenuBtn" alignment="CENTER" mnemonicParsing="false" onAction="#goToEmployees" prefHeight="24.0" prefWidth="119.0" style="-fx-background-radius: 20; -fx-background-color: #F9F6F0;" text="Сотрудники" textAlignment="CENTER" textFill="#771011">
                    <font>
                        <Font name="Open Sans Regular" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="consumablesMenuBtn" mnemonicParsing="false" onAction="#goToConsumables" prefHeight="29.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Расходники" textFill="#f9f6f0">
                    <font>
                        <Font name="Open Sans Regular" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="servicesMenuBtn" mnemonicParsing="false" onAction="#goToServices" prefHeight="29.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" text="Услуги" textFill="#771011">
                    <font>
                        <Font name="Open Sans Regular" size="13.0" />
                    </font>
                </Button>
                <Button fx:id="clientsMenuBtn" mnemonicParsing="false" onAction="#goToClients" prefHeight="31.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" text="Клиенты" textFill="#771011">
                    <font>
                        <Font name="Open Sans Regular" size="13.0" />
                    </font>
                </Button>
            </buttons>
            <padding>
                <Insets left="-20.0" />
            </padding>
        </ButtonBar>

        <Button fx:id="backButton" alignment="CENTER" layoutX="19.0" layoutY="376.0" mnemonicParsing="false" onAction="#goBack" prefHeight="29.0" prefWidth="76.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Назад" textAlignment="CENTER" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <Button fx:id="editButton" alignment="CENTER" layoutX="489.0" layoutY="376.0" mnemonicParsing="false" onAction="#editConsumable" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Изменить" textAlignment="CENTER" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <Button fx:id="addButton" alignment="CENTER" layoutX="392.0" layoutY="376.0" mnemonicParsing="false" onAction="#addConsumable" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Добавить" textAlignment="CENTER" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <Button fx:id="deleteButton" alignment="CENTER" layoutX="295.0" layoutY="376.0" mnemonicParsing="false" onAction="#deleteConsumable" prefHeight="29.0" prefWidth="86.0" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Удалить" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" />
    </children>
</AnchorPane>
