<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.AddConsumableController">
    <children>
        <Label layoutX="170.0" layoutY="30.0" text="Добавить позицию" AnchorPane.topAnchor="30.0">
            <font>
                <Font name="Maika" size="24.0" />
            </font>
        </Label>

        <TextField fx:id="nameField" layoutX="150.0" layoutY="127.0" prefHeight="27.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />
        <TextField fx:id="quantityField" layoutX="200.0" layoutY="166.0" prefHeight="27.0" prefWidth="322.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />
        <TextField fx:id="priceField" layoutX="150.0" layoutY="206.0" prefHeight="25.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />
        <TextField fx:id="unitField" layoutX="224.0" layoutY="245.0" prefHeight="27.0" prefWidth="298.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />

        <Label layoutX="78.0" layoutY="131.0" text="Название">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <Label layoutX="78.0" layoutY="170.0" text="Количество, шт.">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <Label layoutX="78.0" layoutY="210.0" text="Цена, руб">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <Label layoutX="78.0" layoutY="248.0" prefHeight="18.0" prefWidth="164.0" text="Единица измерения">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>

        <Label fx:id="errorLabel" layoutX="150.0" layoutY="290.0" textFill="red" visible="false">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>

        <Label alignment="CENTER" contentDisplay="CENTER" layoutX="246.0" layoutY="69.0" text="Расходники" textFill="#771011">
            <font>
                <Font name="Maika" size="16.0" />
            </font>
        </Label>

        <Button fx:id="backButton" layoutX="40.0" layoutY="381.0" mnemonicParsing="false" onAction="#cancel" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Назад" textFill="WHITE" AnchorPane.leftAnchor="40.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <Button fx:id="saveButton" layoutX="473.0" layoutY="381.0" mnemonicParsing="false" onAction="#saveConsumable" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Сохранить" textFill="WHITE" AnchorPane.rightAnchor="40.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" />
    </children>
</AnchorPane>
