<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.ChangeScheduleController">
    <children>
        <Label layoutX="125.0" layoutY="22.0" text="Изменить позицию">
            <font>
                <Font name="Maika" size="24.0" />
            </font>
        </Label>

        <Label layoutX="50.0" layoutY="99.0" text="День недели">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <ComboBox fx:id="dayComboBox" layoutX="50.0" layoutY="119.0" prefHeight="27.0" prefWidth="400.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />

        <Label layoutX="50.0" layoutY="169.0" text="Время начала">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="startTimeField" layoutX="50.0" layoutY="189.0" prefHeight="27.0" prefWidth="180.0" promptText="10:00" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />

        <Label layoutX="270.0" layoutY="169.0" text="Время окончания">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="endTimeField" layoutX="270.0" layoutY="189.0" prefHeight="27.0" prefWidth="180.0" promptText="18:00" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />

        <Label fx:id="errorLabel" layoutX="50.0" layoutY="220.0" prefHeight="27.0" prefWidth="400.0" textFill="red" visible="false">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>

        <Button fx:id="backButton" layoutX="50.0" layoutY="330.0" mnemonicParsing="false" onAction="#cancel" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Назад" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <Button fx:id="saveButton" layoutX="380.0" layoutY="330.0" mnemonicParsing="false" onAction="#updateSchedule" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Сохранить" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <HBox alignment="CENTER" layoutY="375.0" prefHeight="25.0" prefWidth="500.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" />
      <Label layoutX="193.0" layoutY="62.0" text="Расписание" textFill="#771011">
         <font>
            <Font name="Maika" size="18.0" />
         </font>
      </Label>
    </children>
</AnchorPane>
