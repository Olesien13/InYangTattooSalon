<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.AddScheduleController">
    <children>
        <Label layoutX="170.0" layoutY="30.0" text="Добавить позицию">
            <font>
                <Font name="Maika" size="24.0" />
            </font>
        </Label>

        <Label layoutX="250.0" layoutY="70.0" text="Расписание" textFill="#771011">
            <font>
                <Font name="Maika" size="16.0" />
            </font>
        </Label>

        <Label layoutX="80.0" layoutY="100.0" text="Мастер">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <ComboBox fx:id="masterComboBox" layoutX="80.0" layoutY="120.0" prefHeight="27.0" prefWidth="440.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />

        <Label layoutX="80.0" layoutY="170.0" text="День недели">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <ComboBox fx:id="dayComboBox" layoutX="80.0" layoutY="190.0" prefHeight="27.0" prefWidth="440.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />

        <Label layoutX="80.0" layoutY="240.0" text="Время начала">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="startTimeField" layoutX="80.0" layoutY="260.0" prefHeight="27.0" prefWidth="200.0" promptText="10:00" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />

        <Label layoutX="320.0" layoutY="240.0" text="Время окончания">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="endTimeField" layoutX="320.0" layoutY="260.0" prefHeight="27.0" prefWidth="200.0" promptText="18:00" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />

        <Label fx:id="errorLabel" layoutX="80.0" layoutY="310.0" prefHeight="27.0" prefWidth="440.0" textFill="red" visible="false">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>

        <Button fx:id="backButton" layoutX="50.0" layoutY="381.0" mnemonicParsing="false" onAction="#cancel" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Назад" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <Button fx:id="saveButton" layoutX="463.0" layoutY="381.0" mnemonicParsing="false" onAction="#saveSchedule" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Сохранить" textFill="WHITE">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" />
    </children>
</AnchorPane>