<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.ChangeClientController">
    <children>
        <Label layoutX="175.0" layoutY="22.0" text="Изменить позицию" AnchorPane.topAnchor="22.0">
            <font>
                <Font name="Maika" size="24.0" />
            </font>
        </Label>

        <TextField fx:id="nameField" layoutX="151.0" layoutY="105.0" prefHeight="25.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />
        <TextField fx:id="phoneField" layoutX="151.0" layoutY="144.0" prefHeight="25.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />
        <TextField fx:id="emailField" layoutX="151.0" layoutY="184.0" prefHeight="25.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />

        <ComboBox fx:id="serviceComboBox" layoutX="195.0" layoutY="223.0" prefHeight="27.0" prefWidth="328.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />

        <TextField fx:id="priceField" layoutX="195.0" layoutY="262.0" prefHeight="27.0" prefWidth="328.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />

        <TextField fx:id="dateField" layoutX="150.0" layoutY="303.0" prefHeight="25.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />
        <ComboBox fx:id="statusComboBox" layoutX="151.0" layoutY="340.0" prefHeight="27.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" />

        <Label layoutX="79.0" layoutY="109.0" text="ФИО">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <Label layoutX="79.0" layoutY="148.0" text="Телефон">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <Label layoutX="79.0" layoutY="188.0" text="Почта">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <Label layoutX="79.0" layoutY="226.0" prefHeight="18.0" prefWidth="164.0" text="Название услуги">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <Label layoutX="79.0" layoutY="266.0" text="Цена (руб)">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <Label layoutX="78.0" layoutY="307.0" text="Дата">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <Label layoutX="79.0" layoutY="344.0" text="Статус">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>

        <Label fx:id="errorLabel" layoutX="150.0" layoutY="380.0" textFill="red" visible="false">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>

        <Label alignment="CENTER" contentDisplay="CENTER" layoutX="263.0" layoutY="62.0" text="Клиенты" textFill="#771011">
            <font>
                <Font name="Maika" size="16.0" />
            </font>
        </Label>

        <Button fx:id="backButton" layoutX="40.0" layoutY="385.0" mnemonicParsing="false" onAction="#cancel" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Назад" textFill="WHITE" AnchorPane.leftAnchor="40.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <Button fx:id="saveButton" layoutX="473.0" layoutY="385.0" mnemonicParsing="false" onAction="#updateClient" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Сохранить" textFill="WHITE" AnchorPane.rightAnchor="40.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <HBox alignment="CENTER" layoutY="426.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" />
    </children>
</AnchorPane>
