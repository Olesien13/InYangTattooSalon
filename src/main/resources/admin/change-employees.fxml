<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<!-- окно редактирования сотрудника -->

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.ChangeEmployeeController">

    <children>

        <!-- заголовок по центру -->
        <Label alignment="CENTER" layoutX="170.0" layoutY="30.0" text="Изменить позицию" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="30.0">
            <font>
                <Font name="Maika" size="24.0" />
            </font>
        </Label>

        <Label alignment="CENTER" layoutX="239.0" layoutY="68.0" text="&quot;сотрудники&quot;" textFill="#771011" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="68.0">
            <font>
                <Font name="Maika" size="16.0" />
            </font>
        </Label>

        <!-- фио -->
        <Label layoutX="68.0" layoutY="132.0" text="ФИО" AnchorPane.leftAnchor="68.0" AnchorPane.topAnchor="132.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="nameField" layoutX="150.0" layoutY="127.0" prefHeight="25.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="127.0" />

        <!-- телефон -->
        <Label layoutX="68.0" layoutY="171.0" text="Телефон" AnchorPane.leftAnchor="68.0" AnchorPane.topAnchor="171.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="phoneField" layoutX="150.0" layoutY="166.0" prefHeight="25.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="166.0" />

        <!-- должность -->
        <Label layoutX="68.0" layoutY="211.0" text="Должность" AnchorPane.leftAnchor="68.0" AnchorPane.topAnchor="211.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <ComboBox fx:id="positionComboBox" layoutX="150.0" layoutY="206.0" prefHeight="25.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="206.0" />

        <!-- дата трудоустройства -->
        <Label layoutX="68.0" layoutY="249.0" text="Дата (трудоустройства)" AnchorPane.leftAnchor="68.0" AnchorPane.topAnchor="249.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="hireDateField" layoutX="230.0" layoutY="245.0" prefHeight="27.0" prefWidth="292.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" AnchorPane.leftAnchor="230.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="245.0" />

        <!-- зарплата -->
        <Label layoutX="68.0" layoutY="289.0" text="Зарплата" AnchorPane.leftAnchor="68.0" AnchorPane.topAnchor="289.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="salaryField" layoutX="150.0" layoutY="284.0" prefHeight="25.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="284.0" />

        <!-- ошибки -->
        <Label fx:id="errorLabel" layoutX="150.0" layoutY="330.0" textFill="red" visible="false" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="330.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>

        <!-- кнопки -->
        <Button fx:id="backButton" layoutX="50.0" layoutY="381.0" mnemonicParsing="false" onAction="#cancel" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Назад" textFill="WHITE" AnchorPane.bottomAnchor="44.0" AnchorPane.leftAnchor="40.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <Button fx:id="saveButton" layoutX="463.0" layoutY="381.0" mnemonicParsing="false" onAction="#updateEmployee" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Сохранить" textFill="WHITE" AnchorPane.bottomAnchor="44.0" AnchorPane.rightAnchor="40.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- декоративная полоса -->
        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />

    </children>
</AnchorPane>
