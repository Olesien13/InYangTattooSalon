<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<!-- окно редактирования расходника -->

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.ChangeConsumableController">

    <children>

        <!-- заголовок по центру -->
        <Label alignment="CENTER" contentDisplay="CENTER" layoutX="170.0" layoutY="30.0" text="Изменить позицию" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="30.0">
            <font>
                <Font name="Maika" size="24.0" />
            </font>
        </Label>

        <!-- подзаголовок -->
        <Label alignment="CENTER" contentDisplay="CENTER" layoutX="246.0" layoutY="69.0" text="Расходники" textFill="#771011" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="69.0">
            <font>
                <Font name="Maika" size="16.0" />
            </font>
        </Label>

        <!-- название -->
        <Label layoutX="78.0" layoutY="131.0" text="Название" AnchorPane.leftAnchor="78.0" AnchorPane.topAnchor="131.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="nameField" layoutX="150.0" layoutY="127.0" prefHeight="27.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="127.0" />

        <!-- количество -->
        <Label layoutX="78.0" layoutY="170.0" text="Количество, шт." AnchorPane.leftAnchor="78.0" AnchorPane.topAnchor="170.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="quantityField" layoutX="200.0" layoutY="166.0" prefHeight="27.0" prefWidth="322.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="166.0" />

        <!-- цена -->
        <Label layoutX="78.0" layoutY="210.0" text="Цена, руб" AnchorPane.leftAnchor="78.0" AnchorPane.topAnchor="210.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="priceField" layoutX="150.0" layoutY="206.0" prefHeight="25.0" prefWidth="372.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="206.0" />

        <!-- единица измерения -->
        <Label layoutX="78.0" layoutY="248.0" text="Единица измерения" AnchorPane.leftAnchor="78.0" AnchorPane.topAnchor="248.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>
        <TextField fx:id="unitField" layoutX="219.0" layoutY="245.0" prefHeight="27.0" prefWidth="303.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" AnchorPane.leftAnchor="219.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="245.0" />

        <!-- ошибки -->
        <Label fx:id="errorLabel" layoutX="150.0" layoutY="290.0" textFill="red" visible="false" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="78.0" AnchorPane.topAnchor="290.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>

        <!-- кнопки -->
        <Button fx:id="backButton" layoutX="40.0" layoutY="381.0" mnemonicParsing="false" onAction="#cancel" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Назад" textFill="WHITE" AnchorPane.bottomAnchor="44.0" AnchorPane.leftAnchor="40.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <Button fx:id="saveButton" layoutX="473.0" layoutY="381.0" mnemonicParsing="false" onAction="#updateConsumable" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Сохранить" textFill="WHITE" AnchorPane.bottomAnchor="44.0" AnchorPane.rightAnchor="40.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- декоративная полоса -->
        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />

    </children>
</AnchorPane>
