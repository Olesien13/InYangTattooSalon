<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.ClientsController">

    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>

    <children>

        <!-- Верхнее меню -->
        <HBox alignment="CENTER" layoutX="67.0" layoutY="20.0" prefHeight="33.0" prefWidth="431.0" spacing="5" style="-fx-background-radius: 20; -fx-border-color: #771011; -fx-border-radius: 20; -fx-padding: 0 0 0 0;" AnchorPane.leftAnchor="67.0" AnchorPane.rightAnchor="73.0" AnchorPane.topAnchor="20.0">
            <Button fx:id="employeesMenuBtn" alignment="CENTER" mnemonicParsing="false" onAction="#goToEmployees" prefHeight="26.0" prefWidth="132.0" style="-fx-background-radius: 20; -fx-background-color: #F9F6F0;" text="Сотрудники" textFill="#771011">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="consumablesMenuBtn" mnemonicParsing="false" onAction="#goToConsumables" prefHeight="31.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" text="Расходники" textFill="#771011">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="servicesMenuBtn" mnemonicParsing="false" onAction="#goToServices" prefHeight="31.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" text="Услуги" textFill="#771011">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="clientsMenuBtn" mnemonicParsing="false" onAction="#goToClients" prefHeight="31.0" prefWidth="120.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Клиенты" textFill="white">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
        </HBox>

        <!-- Таблица клиентов -->
        <TableView fx:id="clientsTable" layoutX="15.0" layoutY="69.0" prefHeight="292.0" prefWidth="571.0" styleClass="table" AnchorPane.bottomAnchor="95.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="74.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="40.0" text="Id">
                    <styleClass>
                        <String fx:value="table-header" />
                        <String fx:value="table-header-bok-right" />
                    </styleClass>
                </TableColumn>
                <TableColumn fx:id="colName" prefWidth="120.0" styleClass="table-header" text="ФИО" />
                <TableColumn fx:id="colPhone" prefWidth="100.0" styleClass="table-header" text="Телефон" />
                <TableColumn fx:id="colEmail" prefWidth="120.0" styleClass="table-header" text="Почта" />
                <TableColumn fx:id="colServiceName" prefWidth="100.0" styleClass="table-header" text="Название услуги" />
                <TableColumn fx:id="colTotalSpent" prefWidth="80.0" styleClass="table-header" text="Всего потратил" />
                <TableColumn fx:id="colSize" prefWidth="80.0" styleClass="table-header" text="Размер" />
                <TableColumn fx:id="colRegistrationDate" prefWidth="100.0" styleClass="table-header" text="Дата регистрации" />
                <TableColumn fx:id="colStatus" prefWidth="80.0" text="Статус">
                    <styleClass>
                        <String fx:value="table-header" />
                        <String fx:value="table-header-bok-left" />
                    </styleClass>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Кнопки внизу -->
        <HBox alignment="CENTER_RIGHT" spacing="15" AnchorPane.bottomAnchor="45.0" AnchorPane.rightAnchor="15.0">
            <Button fx:id="deleteButton" alignment="CENTER" mnemonicParsing="false" onAction="#deleteClient" prefHeight="29.0" prefWidth="86.0" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Удалить" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="addButton" alignment="CENTER" mnemonicParsing="false" onAction="#addClient" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Добавить" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="editButton" alignment="CENTER" mnemonicParsing="false" onAction="#editClient" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Изменить" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
        </HBox>

        <!-- Кнопка "Отчёт по расходникам" -->
        <Button fx:id="consumablesReportBtn" alignment="CENTER" mnemonicParsing="false" onAction="#showClientConsumables" prefHeight="29.0" prefWidth="171.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Отчёт по расходникам" textFill="WHITE" AnchorPane.bottomAnchor="45.0" AnchorPane.leftAnchor="109.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- Кнопка "Назад" -->
        <Button fx:id="backButton" alignment="CENTER" mnemonicParsing="false" onAction="#goBack" prefHeight="29.0" prefWidth="76.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Назад" textFill="WHITE" AnchorPane.bottomAnchor="45.0" AnchorPane.leftAnchor="15.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- Декоративная полоса -->
        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
    </children>

</AnchorPane>
