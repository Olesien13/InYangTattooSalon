<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.client.Kholenko.MyBookingsController">
   <stylesheets>
      <URL value="@styles.css" />
   </stylesheets>

   <children>
   <Region layoutX="238.0" layoutY="30.0" prefHeight="1.0" prefWidth="130.0" style="-fx-background-color: #771011;" />
      <VBox alignment="CENTER" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="10">

      <!-- Заголовок -->
      <Label styleClass="section-title" text="Мои записи">
         <font>
            <Font name="Maika" size="16.0" />
         </font>
      </Label>
      </VBox>

      <!-- Фильтры -->
      <HBox alignment="CENTER" layoutX="3.0" layoutY="60.0" AnchorPane.leftAnchor="3.0" AnchorPane.rightAnchor="-3.0" AnchorPane.topAnchor="60.0">
         <children>
            <ToggleButton fx:id="allFilterBtn" prefWidth="49.0" selected="true" styleClass="client-tbtn" text="Все |" />
            <ToggleButton fx:id="upcomingFilterBtn" styleClass="client-tbtn" text="Предстоящие |" />
            <ToggleButton fx:id="completedFilterBtn" styleClass="client-tbtn" text="Завершённые" />
         </children>
      </HBox>

      <!-- Таблица -->
      <TableView fx:id="bookingsTable" layoutX="36.8" layoutY="96.0" prefHeight="184.0" prefWidth="538.0" AnchorPane.bottomAnchor="120" AnchorPane.leftAnchor="37.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="96.0">
         <columns>
            <TableColumn fx:id="dateColumn" prefWidth="90.0" text="Дата">
               <styleClass>
                  <String fx:value="table-header-bok-right" />
                  <String fx:value="table-header" />
               </styleClass>
            </TableColumn>
            <TableColumn fx:id="timeColumn" prefWidth="70.0" styleClass="table-header" text="Время" />
            <TableColumn fx:id="masterColumn" prefWidth="120.0" styleClass="table-header" text="Мастер" />
            <TableColumn fx:id="serviceColumn" prefWidth="150.0" styleClass="table-header" text="Услуга" />
            <TableColumn fx:id="statusColumn" prefWidth="125.00003051757812" text="Статус">
               <styleClass>
                  <String fx:value="table-header" />
                  <String fx:value="table-header-bok-left" />
               </styleClass>
            </TableColumn>
         </columns>
      </TableView>

      <!-- Информация о выбранной записи -->
      <Label fx:id="selectedInfoLabel" text="Выбрана запись: " wrapText="true" AnchorPane.bottomAnchor="80" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" />

      <HBox alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="30" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

         <!-- Кнопка отмены -->
      <Button fx:id="cancelButton" maxWidth="150" styleClass="forma-btn-zapis" text="Отменить запись" HBox.hgrow="ALWAYS" />

      <!-- Кнопка переноса (оставлена из старого дизайна, но можно удалить) -->
      <Button maxWidth="150" onAction="#rescheduleBooking" styleClass="forma-btn-zapis" text="Перенести" textFill="#771011" HBox.hgrow="ALWAYS" />
      </HBox>

   </children>
</AnchorPane>
