<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="coursework.itms206.controllers.admin.Shokina.ClientConsumablesReportController">

    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>

    <children>

        <!-- Заголовок -->
        <Label alignment="CENTER" layoutX="210.0" layoutY="20.0" text="Отчёт по расходникам" textFill="#771011" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="20.0">
            <font>
                <Font name="Maika" size="20.0" />
            </font>
        </Label>

        <!-- Имя клиента -->
        <Label fx:id="clientNameLabel" layoutX="30.0" layoutY="60.0" text="Клиент: " textFill="#771011" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="60.0">
            <font>
                <Font name="Open Sans Regular" size="14.0" />
            </font>
        </Label>

        <!-- Выбор записи -->
        <Label layoutX="30.0" layoutY="95.0" text="Выберите запись:" textFill="#771011" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="95.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Label>

        <ComboBox fx:id="appointmentComboBox" layoutX="180.0" layoutY="90.0" prefHeight="27.0" prefWidth="380.0" style="-fx-border-radius: 15; -fx-background-radius: 15; -fx-border-color: #771011;" AnchorPane.leftAnchor="180.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="90.0" />

        <!-- Таблица расходников -->
        <TableView fx:id="consumablesTable" layoutX="30.0" layoutY="135.0" prefHeight="230.0" prefWidth="540.0" styleClass="table" AnchorPane.bottomAnchor="85.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="135.0">
            <columns>
                <TableColumn fx:id="colConsumableName" prefWidth="250.0" text="Расходный материал">
                    <styleClass>
                        <String fx:value="table-header-bok-right" />
                        <String fx:value="table-header" />
                    </styleClass>
                </TableColumn>
                <TableColumn fx:id="colUsedQuantity" prefWidth="120.0" text="Использовано">
                    <styleClass>
                        <String fx:value="table-header" />
                    </styleClass>
                </TableColumn>
                <TableColumn fx:id="colTotalPrice" prefWidth="170.0" text="Стоимость (руб)">
                    <styleClass>
                        <String fx:value="table-header-bok-left" />
                        <String fx:value="table-header" />
                    </styleClass>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Общая стоимость -->
        <Label fx:id="totalLabel" text="Общая стоимость: 0 руб" textFill="#771011" AnchorPane.bottomAnchor="45.0" AnchorPane.leftAnchor="30.0">
            <font>
                <Font name="Open Sans Regular" size="14.0" />
            </font>
        </Label>

        <!-- Кнопка Закрыть -->
        <Button fx:id="closeButton" alignment="CENTER" mnemonicParsing="false" onAction="#closeWindow" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Закрыть" textAlignment="CENTER" textFill="WHITE" AnchorPane.bottomAnchor="40.0" AnchorPane.rightAnchor="30.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- Декоративная полоса -->
        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
    </children>

</AnchorPane>
