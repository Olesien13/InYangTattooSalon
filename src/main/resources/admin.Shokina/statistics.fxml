<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.Shokina.StatisticsController">

    <stylesheets>
        <URL value="@chart-colors.css" />
    </stylesheets>

    <children>

        <!-- заголовок по центру -->
        <HBox alignment="CENTER" layoutY="20.0" prefHeight="31.0" prefWidth="600.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="20.0">
            <Button alignment="CENTER" mnemonicParsing="false" prefHeight="26.0" prefWidth="200.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Статистика" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
        </HBox>

        <!-- вкладки с диаграммами -->
        <TabPane layoutX="20.0" layoutY="70.0" prefHeight="310.0" prefWidth="560.0" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="70.0">
            <tabs>
                <Tab text="Доход компании">
                    <content>
                        <AnchorPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <PieChart fx:id="revenueChart" legendVisible="false" title="Общий доход компании" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0" />
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab text="Заработок мастеров">
                    <content>
                        <AnchorPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <BarChart fx:id="masterRevenueBarChart" title="Заработок мастеров с клиентов" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                <xAxis>
                                    <CategoryAxis fx:id="xAxis" label="Мастер" side="BOTTOM" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="yAxis" label="Заработок (руб)" side="LEFT" />
                                </yAxis>
                            </BarChart>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
            <padding>
                <Insets right="5.0" />
            </padding>
        </TabPane>

        <!-- кнопка назад -->
        <Button fx:id="backButton" alignment="CENTER" layoutX="19.0" layoutY="386.0" mnemonicParsing="false" onAction="#goBack" prefHeight="29.0" prefWidth="76.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Назад" textFill="WHITE" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="19.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- декоративная полоса внизу -->
        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />

    </children>

</AnchorPane>