<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="coursework.itms206.controllers.admin.Shokina.ConsumablesController">

    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>

    <children>

        <!-- Верхнее меню -->
        <HBox alignment="CENTER" layoutX="67.0" layoutY="20.0" prefHeight="33.0" prefWidth="451.0" spacing="5" style="-fx-background-radius: 20; -fx-border-color: #771011; -fx-border-radius: 20; -fx-padding: 0 0 0 0;" AnchorPane.leftAnchor="67.0" AnchorPane.rightAnchor="82.0" AnchorPane.topAnchor="20.0">
            <Button fx:id="employeesMenuBtn" alignment="CENTER" mnemonicParsing="false" onAction="#goToEmployees" prefHeight="26.0" prefWidth="132.0" style="-fx-background-radius: 20; -fx-background-color: #F9F6F0;" text="Сотрудники" textFill="#771011">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="consumablesMenuBtn" mnemonicParsing="false" onAction="#goToConsumables" prefHeight="31.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Расходники" textFill="white">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="servicesMenuBtn" mnemonicParsing="false" onAction="#goToServices" prefHeight="31.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" text="Услуги" textFill="#771011">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="clientsMenuBtn" mnemonicParsing="false" onAction="#goToClients" prefHeight="31.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" text="Клиенты" textFill="#771011">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
        </HBox>

        <!-- Таблица расходников -->
        <TableView fx:id="consumablesTable" layoutX="57.0" layoutY="83.0" prefHeight="258.0" prefWidth="472.0" styleClass="table" AnchorPane.bottomAnchor="95.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="74.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="Id">
                    <styleClass>
                        <String fx:value="table-header" />
                        <String fx:value="table-header-bok-right" />
                    </styleClass>
                </TableColumn>
                <TableColumn fx:id="colName" prefWidth="180.0" styleClass="table-header" text="Название" />
                <TableColumn fx:id="colQuantity" prefWidth="100.0" styleClass="table-header" text="Количество" />
                <TableColumn fx:id="colPrice" prefWidth="100.0" styleClass="table-header" text="Цена" />
                <TableColumn fx:id="colUnit" prefWidth="80.0" text="Ед.изм">
                    <styleClass>
                        <String fx:value="table-header" />
                        <String fx:value="table-header-bok-left" />
                    </styleClass>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Кнопки внизу -->
        <HBox alignment="CENTER_RIGHT" spacing="15" AnchorPane.bottomAnchor="45.0" AnchorPane.rightAnchor="20.0">
            <Button fx:id="deleteButton" alignment="CENTER" mnemonicParsing="false" onAction="#deleteConsumable" prefHeight="29.0" prefWidth="86.0" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Удалить" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="addButton" alignment="CENTER" mnemonicParsing="false" onAction="#addConsumable" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Добавить" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="editButton" alignment="CENTER" mnemonicParsing="false" onAction="#editConsumable" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Изменить" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
        </HBox>

        <!-- Кнопка "Назад" -->
        <Button fx:id="backButton" alignment="CENTER" mnemonicParsing="false" onAction="#goBack" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Назад" textFill="WHITE" AnchorPane.bottomAnchor="45.0" AnchorPane.leftAnchor="20.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- Декоративная полоса -->
        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
    </children>

</AnchorPane>
