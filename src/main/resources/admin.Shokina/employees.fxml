<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="coursework.itms206.controllers.admin.Shokina.EmployeesController">

    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>

    <children>

        <!-- Верхнее меню -->
        <HBox alignment="CENTER" layoutX="67.0" layoutY="20.0" prefHeight="33.0" prefWidth="451.0" spacing="5" style="-fx-background-radius: 20; -fx-border-color: #771011; -fx-border-radius: 20; -fx-padding: 0 0 0 0;" AnchorPane.leftAnchor="67.0" AnchorPane.rightAnchor="82.0" AnchorPane.topAnchor="20.0">
            <Button fx:id="employeesMenuBtn" alignment="CENTER" mnemonicParsing="false" onAction="#goToEmployees" prefHeight="31.0" prefWidth="119.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Сотрудники" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="consumablesMenuBtn" mnemonicParsing="false" onAction="#goToConsumables" prefHeight="29.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" text="Расходники" textFill="#771011">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="servicesMenuBtn" mnemonicParsing="false" onAction="#goToServices" prefHeight="29.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" text="Услуги" textFill="#771011">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="clientsMenuBtn" mnemonicParsing="false" onAction="#goToClients" prefHeight="31.0" prefWidth="117.0" style="-fx-background-radius: 20; -fx-background-color: transparent;" text="Клиенты" textFill="#771011">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
        </HBox>

        <!-- Таблица сотрудников -->
        <TableView fx:id="employeesTable" layoutX="30.0" layoutY="67.0" prefHeight="292.0" prefWidth="530.0" styleClass="table" AnchorPane.bottomAnchor="95.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="74.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="40.0" text="ID">
                    <styleClass>
                        <String fx:value="table-header-bok-right" />
                        <String fx:value="table-header" />
                    </styleClass>
                </TableColumn>
                <TableColumn fx:id="colName" prefWidth="140.0" styleClass="table-header" text="ФИО" />
                <TableColumn fx:id="colPhone" prefWidth="100.0" styleClass="table-header" text="Телефон" />
                <TableColumn fx:id="colPosition" prefWidth="120.0" styleClass="table-header" text="Должность" />
                <TableColumn fx:id="colHireDate" prefWidth="120.0" styleClass="table-header" text="Дата (трудоустройства)" />
                <TableColumn fx:id="colSalary" prefWidth="100.0" text="Зарплата">
                    <styleClass>
                        <String fx:value="table-header-bok-left" />
                        <String fx:value="table-header" />
                    </styleClass>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Кнопки внизу (Удалить, Добавить, Изменить) -->
        <HBox alignment="CENTER_RIGHT" spacing="15" AnchorPane.bottomAnchor="45.0" AnchorPane.rightAnchor="20.0">
            <Button fx:id="deleteButton" alignment="CENTER" mnemonicParsing="false" onAction="#deleteEmployee" prefHeight="29.0" prefWidth="86.0" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Удалить" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="addButton" alignment="CENTER" mnemonicParsing="false" onAction="#addEmployee" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Добавить" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="editButton" alignment="CENTER" mnemonicParsing="false" onAction="#editEmployee" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Изменить" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
        </HBox>

        <!-- Кнопка "Расписание" -->
        <Button fx:id="scheduleButton" alignment="CENTER" mnemonicParsing="false" onAction="#showSchedule" prefHeight="29.0" prefWidth="165.0" style="-fx-background-radius: 20; -fx-background-color: #F9F6F0; -fx-border-color: #771011; -fx-border-radius: 20;" text="Расписание" textFill="#771011" AnchorPane.bottomAnchor="45.0" AnchorPane.leftAnchor="109.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- Кнопка "Назад" -->
        <Button fx:id="backButton" alignment="CENTER" mnemonicParsing="false" onAction="#goBack" prefHeight="29.0" prefWidth="76.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Назад" textFill="WHITE" AnchorPane.bottomAnchor="45.0" AnchorPane.leftAnchor="20.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- Декоративная полоса -->
        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
    </children>

</AnchorPane>
