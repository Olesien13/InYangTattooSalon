<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #F9F6F0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.Shokina.ScheduleController">

    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>

    <children>

        <!-- Заголовок -->
        <HBox alignment="CENTER" layoutX="67.0" layoutY="20.0" prefHeight="33.0" prefWidth="451.0" spacing="5" style="-fx-background-radius: 20; -fx-border-color: #771011; -fx-border-radius: 20; -fx-padding: 0 20 0 20;" AnchorPane.leftAnchor="67.0" AnchorPane.rightAnchor="82.0" AnchorPane.topAnchor="20.0">
            <Button fx:id="employeesMenuBtn" alignment="CENTER" mnemonicParsing="false" prefHeight="24.0" prefWidth="408.0" style="-fx-background-radius: 20; -fx-background-color: #F9F6F0;" text="Расписание мастеров" textFill="#771011">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
        </HBox>

        <!-- Таблица расписания -->
        <TableView fx:id="scheduleTable" layoutX="15.0" layoutY="75.0" prefHeight="281.0" prefWidth="571.0" styleClass="table" AnchorPane.bottomAnchor="95.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="75.0">
            <columns>
                <TableColumn fx:id="colMaster" prefWidth="80.0" text="Мастер">
                    <styleClass>
                        <String fx:value="table-header" />
                        <String fx:value="table-header-bok-right" />
                    </styleClass>
                </TableColumn>
                <TableColumn fx:id="colMon" prefWidth="65.0" styleClass="table-header" text="Пн" />
                <TableColumn fx:id="colTue" prefWidth="65.0" styleClass="table-header" text="Вт" />
                <TableColumn fx:id="colWed" prefWidth="65.0" styleClass="table-header" text="Ср" />
                <TableColumn fx:id="colThu" prefWidth="65.0" styleClass="table-header" text="Чт" />
                <TableColumn fx:id="colFri" prefWidth="65.0" styleClass="table-header" text="Пт" />
                <TableColumn fx:id="colSat" prefWidth="65.0" styleClass="table-header" text="Сб" />
                <TableColumn fx:id="colSun" prefWidth="65.0" text="Вс">
                    <styleClass>
                        <String fx:value="table-header" />
                        <String fx:value="table-header-bok-left" />
                    </styleClass>
                </TableColumn>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Кнопки внизу (Удалить, Добавить, Изменить) -->
        <HBox alignment="CENTER_RIGHT" spacing="15" AnchorPane.bottomAnchor="45.0" AnchorPane.rightAnchor="15.0">
            <Button fx:id="deleteButton" alignment="CENTER" mnemonicParsing="false" onAction="#deleteSchedule" prefHeight="29.0" prefWidth="86.0" style="-fx-background-color: #771011; -fx-background-radius: 20;" text="Удалить" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="addButton" alignment="CENTER" mnemonicParsing="false" onAction="#addSchedule" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Добавить" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
            <Button fx:id="editButton" alignment="CENTER" mnemonicParsing="false" onAction="#editSchedule" prefHeight="29.0" prefWidth="86.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Изменить" textFill="WHITE">
                <font>
                    <Font name="Open Sans Regular" size="13.0" />
                </font>
            </Button>
        </HBox>

        <!-- Кнопка "Назад" -->
        <Button fx:id="backButton" alignment="CENTER" mnemonicParsing="false" onAction="#goBack" prefHeight="29.0" prefWidth="76.0" style="-fx-background-radius: 20; -fx-background-color: #771011;" text="Назад" textFill="WHITE" AnchorPane.bottomAnchor="45.0" AnchorPane.leftAnchor="15.0">
            <font>
                <Font name="Open Sans Regular" size="13.0" />
            </font>
        </Button>

        <!-- Декоративная полоса -->
        <HBox alignment="CENTER" layoutY="425.0" prefHeight="25.0" prefWidth="600.0" style="-fx-background-color: #771011; -fx-background-radius: 10 10 0 0;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" />
    </children>

</AnchorPane>
